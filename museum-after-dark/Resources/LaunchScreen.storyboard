                        <viewLayoutGuide key="safeArea" id="safe"/>
                        <color key="backgroundColor" red="0.035" green="0.053" blue="0.061" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="title" firstAttribute="centerX" secondItem="canvas" secondAttribute="centerX" id="cx1"/>
                            <constraint firstItem="title" firstAttribute="bottom" secondItem="canvas" secondAttribute="centerY" constant="-8" id="cy1"/>
                            <constraint firstItem="subtitle" firstAttribute="centerX" secondItem="canvas" secondAttribute="centerX" id="cx2"/>
                            <constraint firstItem="subtitle" firstAttribute="top" secondItem="title" secondAttribute="bottom" constant="-2" id="cy2"/>
                        </constraints>
                    </view>
