<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="canvas">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="MUSEUM" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                                <rect key="frame" x="86" y="360" width="221" height="58"/>
                                <fontDescription key="fontDescription" name="Baskerville" family="Baskerville" pointSize="49"/>
                                <color key="textColor" red="0.96" green="0.91" blue="0.80" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="After Dark" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="subtitle">
                                <rect key="frame" x="84" y="418" width="225" height="53"/>
                                <fontDescription key="fontDescription" name="Baskerville-Italic" family="Baskerville" pointSize="44"/>
                                <color key="textColor" red="0.78" green="0.64" blue="0.43" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </label>
