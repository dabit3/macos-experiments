{
  "name": "launch-video-a11y-xray",
  "private": true,
  "version": "1.0.0",
  "description": "Devin on macOS launch video: Accessibility X-Ray",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts A11yXray out/a11y-xray.mp4 --codec h264 --crf 14 --pixel-format yuv420p --concurrency 6",
    "still": "remotion still src/index.ts A11yXray",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/roboto-mono": "5.2.8",
    "@remotion/cli": "4.0.525",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/react": "19.1.13",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  },
  "type": "module"
}
