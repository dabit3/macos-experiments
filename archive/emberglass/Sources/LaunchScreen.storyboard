<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Emberglass" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                                <fontDescription key="fontDescription" name="Didot" family="Didot" pointSize="42"/>
                                <color key="textColor" red="0.933" green="0.910" blue="0.851" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="fire into form" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="subtitle">
                                <fontDescription key="fontDescription" name="Didot-Italic" family="Didot" pointSize="19"/>
                                <color key="textColor" red="0.808" green="0.678" blue="0.471" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe"/>
                        <color key="backgroundColor" red="0.043" green="0.063" blue="0.071" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="title" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="cx"/>
                            <constraint firstItem="title" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" constant="-12" id="cy"/>
                            <constraint firstItem="subtitle" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="scx"/>
                            <constraint firstItem="subtitle" firstAttribute="top" secondItem="title" secondAttribute="bottom" constant="16" id="sy"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
