.devin/clone-this/lastfort/evidence/**/*.mov
.devin/clone-this/lastfort/evidence/**/*.mp4
# Harness runtime scratch (control flags, compiled window-id helper)
.devin/clone-this/lastfort/evidence/tests/*/ctl/
.devin/clone-this/lastfort/evidence/tests/*/window_id
